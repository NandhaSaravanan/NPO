# Public URL of the deployed site (used for sitemap, canonical URLs, Open Graph).
NEXT_PUBLIC_SITE_URL=https://your-domain.org

# Supabase: form submissions are stored here. See README, "Connect the forms".
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Not used for writes; safe to expose.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...). Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Alternative to Supabase: POST submissions as JSON (Formspree, Apps Script).
# Only used when Supabase is not configured. Leave empty for the mailto: fallback.
FORM_ENDPOINT=
